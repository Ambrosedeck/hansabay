# Server
PORT=3000
# Secret used to sign session cookies. Change this to a long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Admin login. Only used the FIRST time the database is created
# (afterwards, change it from the admin panel).
ADMIN_PASSWORD=admin123

# Default pack passwords, also only used on first run.
STARTER_PASSWORD=starter123
BOOSTER_PASSWORD=booster123
PREMIUM_PASSWORD=premium123

# Where the SQLite database file lives
DATABASE_PATH=./data/app.db

# ---- Storage ----
# STORAGE_DRIVER=local  -> uploaded videos saved to UPLOAD_DIR on this server
# STORAGE_DRIVER=s3     -> uploaded videos saved to an S3-compatible bucket
STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads
# Max upload size in megabytes
MAX_UPLOAD_MB=2048

# Only needed when STORAGE_DRIVER=s3
# (run: npm install @aws-sdk/client-s3 @aws-sdk/s3-request-presigner)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
